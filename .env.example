# WordPress + WooCommerce backend URL (default: https://store.javagadget.com)
WP_SITE_URL=https://store.javagadget.com

# WooCommerce REST API v3 credentials
# Buat di: https://store.javagadget.com/wp-admin/admin.php?page=wc-settings&tab=advanced&section=keys
# Permission: Read/Write (diperlukan untuk checkout, ongkir, kupon, lacak pesanan, & registrasi)
# Catatan: Tanpa key ini, katalog produk & blog tetap berjalan via public Store API & WP REST API v2.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Opsional: WordPress Application Password jika butuh akses endpoint WP privat
# WP_USERNAME=
# WP_APP_PASSWORD=
